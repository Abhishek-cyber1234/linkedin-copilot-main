# Serverless hosts (Netlify, Vercel): a Postgres URL, e.g. from Netlify DB or Neon.
# Netlify DB sets NETLIFY_DATABASE_URL automatically.
# DATABASE_URL=postgres://...

# Optional: where the SQLite database lives when DATABASE_URL is not set (default: ./data/copilot.db)
# DATABASE_PATH=./data/copilot.db
